<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" styleClass="pantalla" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ReporteController">

    <children>

        <Label alignment="CENTER" layoutX="225.0" layoutY="14.0" prefHeight="32.0" prefWidth="150.0" styleClass="titulo-pantalla" text="REPORTES" />
        <Label layoutX="95.0" layoutY="95.0" styleClass="subtitulo" text="TIPO DE REPORTE" />
        <ComboBox fx:id="cmbTipoReporte" layoutX="245.0" layoutY="91.0" prefHeight="25.0" prefWidth="250.0" />
        <Label layoutX="95.0" layoutY="135.0" styleClass="subtitulo" text="ACTIVIDAD" />
        <ComboBox fx:id="cmbActividad" layoutX="245.0" layoutY="131.0" prefHeight="25.0" prefWidth="250.0" />
        <Label layoutX="95.0" layoutY="190.0" styleClass="subtitulo" text="PERÍODO" />
        <Label layoutX="175.0" layoutY="230.0" text="DESDE" />
        <DatePicker fx:id="dpDesde" layoutX="245.0" layoutY="226.0" prefHeight="25.0" prefWidth="150.0" />
        <Label layoutX="175.0" layoutY="270.0" text="HASTA" />
        <DatePicker fx:id="dpHasta" layoutX="245.0" layoutY="266.0" prefHeight="25.0" prefWidth="150.0" />
        <Button fx:id="btnGenerarReporte" layoutX="215.0" layoutY="325.0" mnemonicParsing="false" onAction="#generarReporte" prefHeight="35.0" prefWidth="170.0" styleClass="boton-principal" text="GENERAR REPORTE" />

    </children>

</AnchorPane>
