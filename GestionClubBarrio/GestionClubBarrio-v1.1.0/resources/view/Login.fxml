<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="400.0" prefWidth="700.0" styleClass="pantalla" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.LoginController">

    <children>

        <ImageView fx:id="imgEscudo" fitHeight="115.0" fitWidth="115.0" layoutX="293.0" layoutY="37.0" pickOnBounds="true" preserveRatio="true" />
        <Label alignment="CENTER" layoutX="14.0" layoutY="14.0" prefHeight="45.0" prefWidth="153.0" styleClass="titulo-pantalla" text="INICIO DE SESIÓN" textAlignment="CENTER" />

        <HBox layoutX="217.0" layoutY="234.0">
         <children>
              <Label prefHeight="25.0" prefWidth="90.0" text="USUARIO" />
              <TextField fx:id="txtUsuario" prefHeight="30.0" prefWidth="175.0" promptText="Ingrese usuario" />
         </children>
        </HBox>

        <HBox layoutX="217.0" layoutY="273.0">
         <children>
              <Label prefHeight="25.0" prefWidth="90.0" text="CONTRASEÑA" />
              <PasswordField fx:id="txtClave" prefHeight="30.0" prefWidth="175.0" promptText="Ingrese contraseña" />
         </children>
        </HBox>

        <Button layoutX="285.0" layoutY="320.0" mnemonicParsing="false" onAction="#iniciarSesion" prefHeight="35.0" prefWidth="130.0" styleClass="boton-principal" text="INGRESAR" />
        <Label fx:id="lblMensaje" alignment="CENTER" layoutX="116.0" layoutY="364.0" prefHeight="25.0" prefWidth="468.0" textAlignment="CENTER" />
        <Label fx:id="lblNombreSistema" alignment="CENTER" layoutX="152.0" layoutY="163.0" prefHeight="50.0" prefWidth="395.0" styleClass="titulo-pantalla" text="" textAlignment="CENTER" wrapText="true" />

    </children>

</AnchorPane>
