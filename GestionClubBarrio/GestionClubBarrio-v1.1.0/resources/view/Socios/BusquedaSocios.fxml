<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" styleClass="pantalla" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.Socios.BusquedaSocioController">

    <children>

        <Label alignment="CENTER" layoutX="225.0" layoutY="14.0" prefHeight="32.0" prefWidth="150.0" styleClass="titulo-pantalla" text="BUSCAR SOCIOS" />
        <Label layoutX="93.0" layoutY="63.0" styleClass="subtitulo" text="Buscar por" />
        <ComboBox fx:id="cmbCampo" layoutX="175.0" layoutY="59.0" prefHeight="25.0" prefWidth="250.0" />
        <TextField fx:id="txtValor" layoutX="175.0" layoutY="102.0" prefHeight="25.0" prefWidth="250.0" promptText="Ingrese búsqueda" />
        <Button layoutX="450.0" layoutY="102.0" mnemonicParsing="false" onAction="#buscarSocios" prefHeight="25.0" prefWidth="90.0" text="BUSCAR" />

        <TableView fx:id="tablaResultados" layoutX="15.0" layoutY="141.0" prefHeight="194.0" prefWidth="570.0">
            <columns>
                <TableColumn fx:id="colId" prefWidth="55.0" text="ID Socio" />
                <TableColumn fx:id="colNombre" prefWidth="75.0" text="Nombre" />
                <TableColumn fx:id="colApellido" prefWidth="75.0" text="Apellido" />
                <TableColumn fx:id="colDni" prefWidth="70.0" text="DNI" />
                <TableColumn fx:id="colTelefono" prefWidth="80.0" text="Teléfono" />
                <TableColumn fx:id="colDireccion" prefWidth="85.0" text="Dirección" />
                <TableColumn fx:id="colFechaAlta" prefWidth="75.0" text="Fecha alta" />
                <TableColumn fx:id="colEstado" prefWidth="50.0" text="Estado" />
            </columns>
        </TableView>

        <Button layoutX="190.0" layoutY="350.0" mnemonicParsing="false" onAction="#abrirModificar" prefHeight="32.0" prefWidth="220.0" styleClass="boton-principal" text="MODIFICAR SOCIO" />

    </children>

</AnchorPane>
