<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" styleClass="pantalla" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.Actividades.BusquedaInscripcionesController">

    <children>

        <Label alignment="CENTER" layoutX="225.0" layoutY="14.0" prefHeight="32.0" prefWidth="150.0" styleClass="titulo-pantalla" text="BUSCAR INSCRIPCIONES" />
        <Label fx:id="lblActividad" layoutX="20.0" layoutY="41.0" prefHeight="25.0" prefWidth="540.0" styleClass="subtitulo" text="Actividad:" />
        <ComboBox fx:id="cmbTipo" layoutX="215.0" layoutY="53.0" prefHeight="25.0" prefWidth="170.0" />
        <TextField fx:id="txtBuscar" layoutX="215.0" layoutY="91.0" prefHeight="25.0" prefWidth="170.0" />
        <Button fx:id="btnBuscar" layoutX="260.0" layoutY="125.0" mnemonicParsing="false" onAction="#buscarInscripciones" prefHeight="7.0" prefWidth="80.0" text="BUSCAR" />

        <TableView fx:id="tablaInscriptos" layoutX="20.0" layoutY="161.0" prefHeight="180.0" prefWidth="560.0">
            <columns>
                <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="colNombre" prefWidth="120.0" text="Nombre" />
                <TableColumn fx:id="colApellido" prefWidth="120.0" text="Apellido" />
                <TableColumn fx:id="colDni" prefWidth="100.0" text="DNI" />
                <TableColumn fx:id="colTipo" prefWidth="85.0" text="Tipo" />
                <TableColumn fx:id="colEstado" prefWidth="75.0" text="Estado" />
            </columns>
        </TableView>

        <Button fx:id="btnModificar" layoutX="185.0" layoutY="355.0" mnemonicParsing="false" onAction="#abrirModificar" prefHeight="30.0" prefWidth="230.0" styleClass="boton-principal" text="MODIFICAR INSCRIPCIÓN" />
    </children>

</AnchorPane>
