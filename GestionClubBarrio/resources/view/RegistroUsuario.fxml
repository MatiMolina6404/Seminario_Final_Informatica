<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" styleClass="pantalla" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.RegistroUsuarioController">

    <children>

        <Label alignment="CENTER" layoutX="210.0" layoutY="25.0" prefHeight="32.0" prefWidth="180.0" styleClass="titulo-pantalla" text="REGISTRAR USUARIO" />

        <Label layoutX="145.0" layoutY="95.0" text="Nombre" />
        <TextField fx:id="txtNombre" layoutX="245.0" layoutY="91.0" prefWidth="200.0" />

        <Label layoutX="145.0" layoutY="135.0" text="Apellido" />
        <TextField fx:id="txtApellido" layoutX="245.0" layoutY="131.0" prefWidth="200.0" />

        <Label layoutX="145.0" layoutY="175.0" text="Contraseña" />
        <PasswordField fx:id="txtClave" layoutX="245.0" layoutY="171.0" prefWidth="200.0" />

        <Label layoutX="145.0" layoutY="215.0" text="Rol" />
        <ComboBox fx:id="cmbRol" layoutX="245.0" layoutY="211.0" prefWidth="200.0" />

        <Button layoutX="215.0" layoutY="285.0" onAction="#registrarUsuario" prefHeight="35.0" prefWidth="170.0" styleClass="boton-principal" text="REGISTRAR" />
      <Label alignment="CENTER" layoutX="87.0" layoutY="350.0" prefHeight="35.0" prefWidth="426.0" text="Requisitos de contraseña: Mínimo 8 caracteres, un número, una mayúscula, una minúscula y un símbolo especial (Ej.: !, @, #, $, %, +)" textAlignment="CENTER" wrapText="true" />

    </children>
</AnchorPane>
